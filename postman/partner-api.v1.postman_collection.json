          "raw": "{\n  \"orders\": [\n    {\n      \"pickticketid\": \"PT-0001001\",\n      \"clientcode\": \"ZZ\",\n      \"retailercode\": \"WEB\",\n      \"shipname\": \"Jordan Example\",\n      \"shipaddress1\": \"100 Example Street\",\n      \"shipcity\": \"Edison\",\n      \"shipstate\": \"NJ\",\n      \"shipzip\": \"08817\",\n      \"shipcountry\": \"US\",\n      \"shipresidentialflag\": \"Y\",\n      \"shipmethod\": \"GROUND\",\n      \"requestedshipdate\": \"{{requestedShipDate}}\",\n      \"lines\": [\n        {\n          \"itemlinenumber\": \"1\",\n          \"itemproductid\": \"SKU-EXAMPLE-1\",\n          \"itemorderquantity\": \"1\"\n        }\n      ]\n    }\n  ]\n}",

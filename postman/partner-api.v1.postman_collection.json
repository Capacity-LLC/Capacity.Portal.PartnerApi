{
  "info": {
    "name": "Capacity Partner API v1",
    "description": "Requests from https://partner-docs.capacityllc.com. Choose the Sandbox environment and fill in clientId and clientSecret; a token is fetched automatically. Example values (owner code ZZ, SKU-EXAMPLE-1, ...) are placeholders: replace them with your account values.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Dates in these requests are computed now, on the US Eastern calendar (Capacity business dates).",
          "const easternDate = (days) => new Intl.DateTimeFormat('en-CA', { timeZone: 'America/New_York', year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date(Date.now() + days * 864e5));",
          "pm.variables.set('requestedShipDate', easternDate(7));",
          "pm.variables.set('batchDate', easternDate(0));",
          "// Gets a token with this environment's clientId/clientSecret and reuses it until 60 s before expiry.",
          "if (pm.request.url.getPath().toLowerCase().endsWith('/auth/token')) { return; }",
          "const expiresAt = Number(pm.environment.get('tokenExpiresAt') || 0);",
          "if (pm.environment.get('accessToken') && Date.now() < expiresAt) { return; }",
          "pm.sendRequest({",
          "  url: pm.environment.get('baseUrl') + '/api/v1/auth/token',",
          "  method: 'POST',",
          "  header: { 'Content-Type': 'application/x-www-form-urlencoded' },",
          "  body: { mode: 'urlencoded', urlencoded: [",
          "    { key: 'grant_type', value: 'client_credentials' },",
          "    { key: 'client_id', value: pm.environment.get('clientId') },",
          "    { key: 'client_secret', value: pm.environment.get('clientSecret') },",
          "  ] },",
          "}, (error, response) => {",
          "  if (error || response.code !== 200) { console.error('Token request failed', error || response.code); return; }",
          "  const body = response.json();",
          "  pm.environment.set('accessToken', body.access_token);",
          "  pm.environment.set('tokenExpiresAt', Date.now() + (body.expires_in - 60) * 1000);",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Get an access token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Correlation-ID",
            "value": "{{$guid}}"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "grant_type",
              "value": "client_credentials"
            },
            {
              "key": "client_id",
              "value": "{{clientId}}"
            },
            {
              "key": "client_secret",
              "value": "{{clientSecret}}"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/token",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "token"
          ]
        }
      }
    },
    {
      "name": "Test the connection",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Correlation-ID",
            "value": "{{$guid}}"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/ping",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "ping"
          ]
        }
      }
    },
